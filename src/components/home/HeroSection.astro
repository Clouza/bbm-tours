<section class="relative min-h-[88vh] flex items-center justify-center px-4 md:px-8 overflow-hidden rounded-[2rem] md:rounded-[2.5rem] mb-24 md:mb-32 mx-3 md:mx-4 mt-4 md:mt-6">
  <div class="absolute inset-0 z-0">
    <img
      alt="Luxurious Bali Rice Terraces"
      class="w-full h-full object-cover"
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuDCbiCiH2fruNr9HF9-JyW7dzTSm_PqH2uSPnBcTq1pHKuwLaocxBsAvEHYDocObMP3UeZJ9Eg3gUtu0jRpy7_ADkp-9rfuB2EAepw7GKNmuMG2fi1RYB4q3-ynGbWmfu1jQ5cjUTMJ31GRBJWpuTlxj_IQOIzRZzvHBY22Kd5vRm6PaGZ4r459jRVdv-UenCHUlYDRJOpKoYYddmOvg222pLEloih3tP-wBWJ6i1iFv76FpeSTh3UvSdXq60qtMKv7ovFKykFurZk"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-linear-to-t from-primary/90 via-primary/40 to-black/30"></div>
  </div>

  <div class="relative z-10 text-center max-w-4xl mx-auto px-4 mt-8">
    <h1
      data-aos="fade-up"
      class="font-headline text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold text-white tracking-tight leading-tight mb-6 md:mb-8 drop-shadow-lg"
    >
      Experience the True<br />Essence of Bali
    </h1>
    <p
      data-aos="fade-up"
      data-aos-delay="100"
      class="font-body text-lg md:text-xl lg:text-2xl text-white/90 mb-10 md:mb-12 max-w-2xl mx-auto font-light drop-shadow-md"
    >
      Embark on a transformative journey through Bali's most pristine landscapes and hidden cultural treasures.
    </p>
    <div
      data-aos="fade-up"
      data-aos-delay="200"
      class="flex flex-col sm:flex-row gap-4 justify-center"
    >
      <a
        href="/tours"
        class="bg-secondary-container text-on-secondary-container font-label font-bold uppercase tracking-wider py-4 px-8 md:px-10 rounded-full hover:scale-105 active:scale-95 transition-all duration-300 shadow-[0_8px_20px_rgba(130,85,0,0.3)]"
      >
        Discover Journeys
      </a>
      <a
        href="/contact"
        class="bg-white/10 backdrop-blur-md border border-white/30 text-white font-label font-bold uppercase tracking-wider py-4 px-8 md:px-10 rounded-full hover:bg-white/20 hover:scale-105 active:scale-95 transition-all duration-300 flex items-center justify-center gap-2"
      >
        <span class="material-symbols-outlined">forum</span> Speak with an Expert
      </a>
    </div>
  </div>
</section>
