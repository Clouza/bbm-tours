<section class="max-w-7xl mx-auto px-4 md:px-8 mb-24 md:mb-32">
  <div data-aos="fade-up" class="text-center mb-12 md:mb-16">
    <h2 class="font-headline text-3xl md:text-5xl font-bold text-primary tracking-tight mb-4">
      Voices of Our Guests
    </h2>
    <p class="font-body text-base md:text-lg text-on-surface-variant max-w-2xl mx-auto font-light">
      Reflections from those who have embraced the BBM Tours experience.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
    {testimonials.map((t, i) => (
      <div
        data-aos="fade-up"
        data-aos-delay={String(i * 100)}
        class="bg-surface-container-lowest p-6 md:p-8 rounded-lg shadow-lg border border-outline-variant/20 hover:shadow-xl transition-shadow duration-300 flex flex-col"
      >
        <div class="flex gap-1 text-secondary-container mb-6">
          {Array.from({ length: 5 }).map(() => (
            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">star</span>
          ))}
        </div>
        <p class="font-body text-on-surface-variant leading-relaxed mb-8 italic font-light grow">{t.quote}</p>
        <div class="flex items-center gap-4">
          <img alt={t.name} class="w-12 h-12 rounded-full object-cover shrink-0" src={t.avatar} />
          <div>
            <h4 class="font-headline font-bold text-primary">{t.name}</h4>
            <p class="font-body text-sm text-on-surface-variant/70">{t.origin}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
