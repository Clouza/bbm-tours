---
import toursData from '../../data/tours.json';

const featuredTours = toursData.slice(0, 4).map((tour, index) => {
  const layouts = [
    { colSpan: 'md:col-span-8', height: 'h-[420px] md:h-[500px]', layout: 'wide' },
    { colSpan: 'md:col-span-4', height: 'h-[420px] md:h-[500px]', layout: 'tall' },
    { colSpan: 'md:col-span-5', height: 'h-[360px] md:h-[400px]', layout: 'tall' },
    { colSpan: 'md:col-span-7', height: 'h-[360px] md:h-[400px]', layout: 'wide' },
  ];
  
  return {
    ...tour,
    ...layouts[index],
    delay: (index * 100).toString(),
    price: `From $${tour.price}`
  };
});
---

<section class="max-w-7xl mx-auto px-4 md:px-8 mb-24 md:mb-32 relative">
  <div class="absolute -top-32 -left-32 w-64 h-64 bg-secondary-container/20 rounded-full blur-3xl -z-10"></div>

  <div
    data-aos="fade-up"
    class="mb-12 md:mb-16 flex flex-col md:item-end md:flex-row md:items-end justify-between gap-6"
  >
    <div>
      <h2 class="font-headline text-3xl md:text-5xl font-bold text-primary mb-4 tracking-tight">
        Exclusive Balinese Journeys
      </h2>
      <p class="font-body text-base md:text-lg text-on-surface-variant max-w-2xl font-light">
        Immerse yourself in our meticulously crafted itineraries, blending pure luxury with profound cultural connection.
      </p>
    </div>
    <a
      href="/tours"
      class="text-primary font-label font-bold uppercase tracking-widest text-sm flex items-center gap-2 hover:text-secondary transition-colors shrink-0"
    >
      View All Experiences
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
    {featuredTours.map((tour) => (
      <div
        data-aos="fade-up"
        data-aos-delay={tour.delay}
        class={`${tour.colSpan} group relative rounded-3xl md:rounded-lg overflow-hidden ${tour.height} shadow-xl`}
      >
        <img
          alt={tour.title}
          class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
          src={tour.image}
        />
        <div class="absolute inset-0 bg-linear-to-t from-primary/95 via-primary/30 to-transparent opacity-90 group-hover:opacity-100 transition-opacity duration-500"></div>

        <div class={`absolute bottom-0 left-0 p-6 md:p-8 w-full ${tour.layout === 'wide' ? 'flex justify-between items-end' : ''}`}>
          <div>
            <span class="inline-block bg-white text-primary font-label text-xs font-bold px-4 py-1.5 rounded-full mb-3 tracking-widest uppercase shadow-sm">
              {tour.duration}
            </span>
            <h3 class={`font-headline font-bold text-white mb-2 ${tour.layout === 'wide' ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl leading-tight'}`}>
              {tour.title}
            </h3>
            <p class={`font-body text-secondary-container font-medium ${tour.layout === 'wide' ? 'text-lg md:text-xl' : 'text-base md:text-lg'}`}>
              {tour.price}
              <span class="text-white/70 font-normal text-sm"> / person</span>
            </p>
          </div>

          {tour.layout === 'wide' ? (
            <a
              href={`/tours/${tour.slug}`}
              class="bg-secondary-container text-on-secondary-container w-11 h-11 md:w-12 md:h-12 rounded-full flex items-center justify-center hover:-translate-y-1 hover:shadow-lg transition-all duration-300 shrink-0 ml-4"
              aria-label={`View ${tour.title}`}
            >
              <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">arrow_forward</span>
            </a>
          ) : (
            <div class="flex justify-end mt-4">
              <a
                href={`/tours/${tour.slug}`}
                class="bg-white/20 backdrop-blur-md text-white w-10 h-10 rounded-full flex items-center justify-center hover:bg-secondary-container transition-all duration-300"
                aria-label={`View ${tour.title}`}
              >
                <span class="material-symbols-outlined text-xl">arrow_outward</span>
              </a>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
