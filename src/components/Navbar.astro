---
interface Props {
  activePage?: 'home' | 'destinations' | 'experiences' | 'about';
}

const { activePage = 'home' } = Astro.props;

const links = [
  { label: 'Destinations', page: 'destinations', href: '/tours' },
  { label: 'Experiences',  page: 'experiences',  href: '/tours' },
  { label: 'About Us',     page: 'about',         href: '/about' },
];
---

<!-- Top Navbar -->
<nav class="sticky top-0 w-full z-50 bg-white/80 backdrop-blur-xl shadow-xl shadow-stone-900/5 transition-all duration-300">
  <div class="flex justify-between items-center w-full px-6 md:px-8 py-4 max-w-screen-2xl mx-auto">

    <!-- Brand -->
    <a href="/" class="text-xl md:text-2xl font-headline italic font-bold text-primary hover:scale-[1.02] transition-transform duration-300 shrink-0">
      BBM Tours &amp; Travel
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex gap-8 lg:gap-10 items-center font-label text-xs uppercase tracking-widest">
      {links.map((link) => (
        <a
          href={link.href}
          class={activePage === link.page
            ? 'text-primary font-semibold border-b-2 border-secondary-container pb-1 hover:scale-[1.02] transition-transform duration-300'
            : 'text-stone-600 hover:text-primary transition-colors hover:scale-[1.02] duration-300'}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <!-- Desktop CTA -->
      <a
        href="/contact"
        class="hidden md:inline-flex items-center justify-center bg-secondary-container text-on-secondary-container px-5 py-2.5 rounded-xl font-label text-xs uppercase tracking-widest font-bold hover:scale-[1.02] transition-transform duration-300 shadow-[0_10px_20px_rgba(26,28,27,0.06)]"
      >
        Book Now
      </a>

      <!-- Mobile hamburger (always shows hamburger icon, no X in navbar) -->
      <button
        id="sidebar-open"
        class="md:hidden flex items-center justify-center w-10 h-10 text-primary rounded-lg hover:bg-surface-container-low transition-colors"
        aria-label="Open navigation"
      >
        <span class="material-symbols-outlined text-3xl">menu</span>
      </button>
    </div>

  </div>
</nav>

<!-- Sidebar Overlay -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 z-[60] bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<!-- Sidebar Drawer -->
<aside
  id="sidebar-drawer"
  class="fixed top-0 right-0 z-[70] h-full w-72 bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-in-out md:hidden"
  aria-label="Mobile navigation"
  aria-hidden="true"
>
  <!-- Sidebar Header -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-outline-variant/20">
    <span class="font-headline italic font-bold text-primary text-lg">BBM Tours</span>
    <button
      id="sidebar-close"
      class="flex items-center justify-center w-9 h-9 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant"
      aria-label="Close navigation"
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
  </div>

  <!-- Sidebar Links -->
  <nav class="flex flex-col py-4 grow">
    {links.map((link) => (
      <a
        href={link.href}
        class={`sidebar-link flex items-center gap-3 px-6 py-4 font-label text-xs uppercase tracking-widest transition-colors ${
          activePage === link.page
            ? 'text-primary font-bold bg-surface-container-low border-r-2 border-secondary-container'
            : 'text-stone-600 hover:text-primary hover:bg-surface-container-low'
        }`}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Sidebar CTA -->
  <div class="px-6 py-6 border-t border-outline-variant/20">
    <a
      href="/contact"
      class="sidebar-link block w-full text-center bg-secondary-container text-on-secondary-container px-5 py-3.5 rounded-xl font-label text-xs uppercase tracking-widest font-bold hover:scale-[1.02] transition-transform duration-200"
    >
      Book Now
    </a>
    <p class="font-body text-xs text-on-surface-variant text-center mt-3">
      Free consultation &amp; custom itineraries
    </p>
  </div>
</aside>

<script>
  const openBtn    = document.getElementById('sidebar-open');
  const closeBtn   = document.getElementById('sidebar-close');
  const overlay    = document.getElementById('sidebar-overlay');
  const drawer     = document.getElementById('sidebar-drawer');
  const links      = document.querySelectorAll('.sidebar-link');

  function openSidebar() {
    drawer?.classList.remove('translate-x-full');
    drawer?.setAttribute('aria-hidden', 'false');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
    document.body.classList.add('overflow-hidden');
  }

  function closeSidebar() {
    drawer?.classList.add('translate-x-full');
    drawer?.setAttribute('aria-hidden', 'true');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    overlay?.classList.remove('opacity-100');
    document.body.classList.remove('overflow-hidden');
  }

  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);
  links.forEach((link) => link.addEventListener('click', closeSidebar));

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
