---
interface Inclusion { icon: string; label: string }
interface Props { priceFrom: string; basePrice: number; inclusions: Inclusion[]; whatsappNumber: string }
const { priceFrom, basePrice, inclusions, whatsappNumber } = Astro.props;
---

<div
  data-base-price={basePrice}
  id="booking-widget"
  class="sticky top-32 flex flex-col gap-6 bg-surface/80 backdrop-blur-2xl p-6 md:p-8 rounded-xl shadow-[0_20px_40px_rgba(26,28,27,0.06)] border border-outline-variant/15"
>
  <div>
    <h3 class="font-headline text-xl md:text-2xl text-primary font-bold">Secure Your Spot</h3>
    <p class="font-body text-sm text-on-surface-variant mt-1">Starting from {priceFrom} per person</p>
  </div>

  <!-- Date -->
  <div class="flex flex-col gap-2">
    <label class="font-label text-xs uppercase tracking-widest text-on-surface font-bold">Select Date</label>
    <div class="flex items-center gap-3 bg-surface-container-high px-4 py-3 rounded-lg focus-within:ring-2 focus-within:ring-primary/40 transition-shadow">
      <span class="material-symbols-outlined text-outline shrink-0">calendar_today</span>
      <input
        id="booking-date"
        class="bg-transparent border-none outline-none w-full font-body text-on-surface text-sm focus:ring-0 p-0"
        placeholder="Choose a date..."
        type="date"
        min={new Date().toISOString().split('T')[0]}
      />
    </div>
  </div>

  <!-- Guests -->
  <div class="flex flex-col gap-2">
    <label class="font-label text-xs uppercase tracking-widest text-on-surface font-bold">Guests</label>
    <div class="flex items-center justify-between bg-surface-container-high px-4 py-3 rounded-lg">
      <button id="guests-dec" class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary hover:border-primary transition-all duration-200 font-bold text-lg leading-none" aria-label="Decrease guests">−</button>
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-outline text-xl">group</span>
        <span id="guests-count" class="font-body text-on-surface font-medium w-16 text-center">2 Adults</span>
      </div>
      <button id="guests-inc" class="w-8 h-8 rounded-full border border-outline-variant flex items-center justify-center text-primary hover:bg-primary hover:text-on-primary hover:border-primary transition-all duration-200 font-bold text-lg leading-none" aria-label="Increase guests">+</button>
    </div>
  </div>

  <!-- Total -->
  <div class="flex justify-between items-center py-4 border-t border-outline-variant/20">
    <span class="font-body text-on-surface">Total</span>
    <div class="text-right">
      <span id="total-price" class="font-headline text-2xl md:text-3xl font-bold text-primary">${basePrice * 2}</span>
      <span class="font-body text-xs text-on-surface-variant block">for <span id="guests-summary">2</span> guests</span>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    <button
      id="book-now-btn"
      class="w-full bg-secondary-container text-on-secondary-container py-4 rounded-xl font-label text-sm uppercase tracking-widest font-bold hover:scale-[1.02] transition-transform shadow-lg"
    >
      Book Now
    </button>
    <a
      id="wa-inquire-btn"
      href={`https://wa.me/${whatsappNumber}?text=Halo%20BBM%20Tours%2C%20saya%20ingin%20menanyakan%20tentang%20paket%20wisata%20ini.`}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full bg-linear-to-br from-primary to-primary-container text-on-primary py-4 rounded-lg font-label text-sm uppercase tracking-widest font-bold hover:scale-[1.02] transition-transform flex justify-center items-center gap-2"
    >
      <span class="material-symbols-outlined text-lg">chat</span>
      Inquire via WhatsApp
    </a>
  </div>

  <!-- Booking confirmation dialog (hidden) -->
  <div id="booking-confirm" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
    <div class="bg-surface-container-lowest rounded-xl p-8 max-w-sm w-full shadow-2xl text-center">
      <span class="material-symbols-outlined text-primary text-5xl mb-4 block" style="font-variation-settings:'FILL' 1">check_circle</span>
      <h3 class="font-headline text-2xl text-primary mb-2">Booking Requested!</h3>
      <p class="font-body text-on-surface-variant text-sm mb-6">Our team will confirm your reservation within 2 hours.</p>
      <button id="confirm-close" class="bg-primary text-on-primary font-label text-xs uppercase tracking-widest font-bold px-8 py-3 rounded-full hover:scale-[1.02] transition-transform">
        Done
      </button>
    </div>
  </div>

  <!-- Inclusions -->
  <div class="pt-4 border-t border-outline-variant/20 flex flex-col gap-4">
    <h4 class="font-label text-xs uppercase tracking-widest text-on-surface-variant font-bold">Experience Inclusions</h4>
    <ul class="flex flex-col gap-3">
      {inclusions.map((item) => (
        <li class="flex items-center gap-3 font-body text-sm text-on-surface">
          <span class="material-symbols-outlined text-primary-fixed-dim text-xl shrink-0" style="font-variation-settings:'FILL' 1">{item.icon}</span>
          {item.label}
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  const widget = document.getElementById('booking-widget');
  const basePrice = Number(widget?.dataset.basePrice ?? 120);
  let guests = 2;

  const guestsCount = document.getElementById('guests-count');
  const guestsSummary = document.getElementById('guests-summary');
  const totalPrice = document.getElementById('total-price');
  const decBtn = document.getElementById('guests-dec') as HTMLButtonElement | null;
  const incBtn = document.getElementById('guests-inc') as HTMLButtonElement | null;
  const bookBtn = document.getElementById('book-now-btn');
  const confirmDialog = document.getElementById('booking-confirm');
  const confirmClose = document.getElementById('confirm-close');

  function updateDisplay() {
    if (guestsCount) guestsCount.textContent = `${guests} Adult${guests > 1 ? 's' : ''}`;
    if (guestsSummary) guestsSummary.textContent = String(guests);
    if (totalPrice) totalPrice.textContent = `$${basePrice * guests}`;
    if (decBtn) decBtn.disabled = guests <= 1;
    if (incBtn) incBtn.disabled = guests >= 12;
  }

  decBtn?.addEventListener('click', () => { if (guests > 1) { guests--; updateDisplay(); } });
  incBtn?.addEventListener('click', () => { if (guests < 12) { guests++; updateDisplay(); } });

  bookBtn?.addEventListener('click', () => {
    const dateInput = document.getElementById('booking-date') as HTMLInputElement | null;
    if (!dateInput?.value) {
      dateInput?.focus();
      dateInput?.classList.add('ring-2', 'ring-red-400');
      setTimeout(() => dateInput?.classList.remove('ring-2', 'ring-red-400'), 2000);
      return;
    }
    const lines = [
      `Halo BBM Tours, saya ingin memesan tour ini.`,
      ``,
      `Tanggal: ${dateInput.value}`,
      `Tamu: ${guests} orang`,
      `Total: $${basePrice * guests}`,
    ];
    const waUrl = `https://wa.me/6281238211110?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(waUrl, '_blank', 'noopener,noreferrer');
  });

  confirmClose?.addEventListener('click', () => confirmDialog?.classList.replace('flex', 'hidden'));
  confirmDialog?.addEventListener('click', (e) => { if (e.target === confirmDialog) confirmDialog.classList.replace('flex', 'hidden'); });

  updateDisplay();
</script>
