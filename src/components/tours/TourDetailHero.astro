---
interface Props {
  image: string;
  alt: string;
  badge: string;
  title: string;
  description: string;
}
const { image, alt, badge, title, description } = Astro.props;
---

<section class="relative w-full h-screen max-h-192 min-h-125 flex items-end pb-16 md:pb-24 overflow-hidden">
  <img
    alt={alt}
    class="absolute inset-0 w-full h-full object-cover"
    src={image}
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-linear-to-t from-surface via-surface/40 to-transparent"></div>

  <div class="relative z-10 w-full max-w-screen-2xl mx-auto px-6 md:px-8 flex flex-col gap-3 md:gap-4">
    <div class="inline-flex items-center gap-2 bg-surface-container/80 backdrop-blur-md px-4 py-2 rounded-full w-max">
      <span class="material-symbols-outlined text-secondary text-sm">schedule</span>
      <span class="font-label text-xs font-bold tracking-widest uppercase text-secondary">{badge}</span>
    </div>
    <h1
      data-aos="fade-up"
      class="font-headline text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight text-on-surface max-w-4xl"
    >
      {title}
    </h1>
    <p
      data-aos="fade-up"
      data-aos-delay="100"
      class="font-body text-base md:text-xl text-on-surface-variant max-w-2xl"
    >
      {description}
    </p>
  </div>
</section>
