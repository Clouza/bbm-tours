---
---

<div class="lg:col-span-5 space-y-12 md:space-y-16">
  <div class="space-y-6">

    <!-- WhatsApp CTA -->
    <a
      data-aos="fade-up"
      href="https://wa.me/6281238211110?text=Halo%20BBM%20Tours%2C%20saya%20ingin%20bertanya%20tentang%20paket%20wisata%20Anda."
      target="_blank"
      rel="noopener noreferrer"
      class="block bg-surface-container-lowest p-6 md:p-8 rounded-lg shadow-[0_20px_40px_rgba(26,28,27,0.06)] hover:scale-[1.02] transition-transform duration-300 group"
    >
      <div class="flex items-start gap-5 md:gap-6">
        <div class="w-14 h-14 bg-primary-fixed rounded-full flex items-center justify-center shrink-0 group-hover:bg-secondary-container transition-colors duration-300">
          <span class="material-symbols-outlined text-on-primary-fixed text-2xl group-hover:text-on-secondary-container">chat</span>
        </div>
        <div>
          <p class="font-label text-xs uppercase tracking-widest text-primary-container mb-1">Direct Inquiry</p>
          <p class="font-headline text-xl md:text-2xl text-primary mb-1">WhatsApp Us</p>
          <p class="font-body text-on-surface-variant text-sm">Immediate responses from our local team.</p>
        </div>
      </div>
    </a>

    <!-- Email -->
    <div data-aos="fade-up" data-aos-delay="80" class="flex items-start gap-5 bg-surface-container-low p-5 md:p-6 rounded-lg">
      <div class="w-12 h-12 bg-surface rounded-full flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-primary">mail</span>
      </div>
      <div>
        <p class="font-label text-xs uppercase tracking-widest text-outline mb-1">Email</p>
        <a href="mailto:info@bbmtours.com" class="font-body text-on-surface font-medium hover:text-primary transition-colors">
          info@bbmtours.com
        </a>
      </div>
    </div>

    <!-- Address -->
    <div data-aos="fade-up" data-aos-delay="160" class="flex items-start gap-5 bg-surface-container-low p-5 md:p-6 rounded-lg">
      <div class="w-12 h-12 bg-surface rounded-full flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-primary">location_on</span>
      </div>
      <div>
        <p class="font-label text-xs uppercase tracking-widest text-outline mb-1">Headquarters</p>
        <p class="font-body text-on-surface font-medium leading-relaxed">
          Jalan Raya Sanggingan<br />Ubud, Bali 80571<br />Indonesia
        </p>
      </div>
    </div>
  </div>

  <!-- Map -->
  <div data-aos="fade-up" data-aos-delay="200" class="rounded-lg overflow-hidden h-64 relative shadow-[0_20px_40px_rgba(26,28,27,0.06)]">
    <img
      alt="Map view of Ubud, Bali"
      class="w-full h-full object-cover"
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuD9dtnLZjHVjQWsv9zH5xd984BfsT9OVQr_tm1Y84Q3qNr0-Q_siG9ys8_v0FANde0msILtL42Cv95z1yvID89XOhd7CYxZcu0D3fec8uQPDReBbfcEhXe6xgRJu02xp0skkt2uYVAY5cmYopmWi8qaOay74HoEKOiPqEarozGyEt-ciGTyGy_1Q74ojncBbOGmsM9Zx03HrQFc7XU0m2W3t5KuMKvCuUaBXizvwN_OtSfjaodLteIRvqwrEx_2pGPBOC-ndI1mJog"
    />
    <div class="absolute inset-0 bg-primary/10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center">
      <span class="material-symbols-outlined text-secondary-container text-5xl drop-shadow-md" style="font-variation-settings:'FILL' 1">location_on</span>
      <div class="bg-surface-container-lowest px-3 py-1 rounded-full shadow-sm mt-1">
        <span class="font-label text-xs text-primary font-bold">BBM Tours</span>
      </div>
    </div>
  </div>
</div>
