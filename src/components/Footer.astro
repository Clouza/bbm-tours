---
const exploreLinks = [
  { label: 'Travel Insurance',    href: '#' },
  { label: 'Privacy Policy',      href: '#' },
  { label: 'Terms of Service',    href: '#' },
  { label: 'FAQ',                 href: '#' },
];
---

<footer class="bg-emerald-950 w-full pt-16 md:pt-24 pb-10 md:pb-12">
  <div class="max-w-screen-2xl mx-auto px-6 md:px-8 border-t border-white/10 pt-10 md:pt-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 md:gap-12">

      <!-- Brand -->
      <div class="sm:col-span-2">
        <h3 class="text-2xl md:text-3xl font-headline text-white mb-4 italic">BBM Tours &amp; Travel</h3>
        <p class="font-body text-stone-300 leading-relaxed max-w-md font-light mb-6 text-sm md:text-base">
          Curating conscious Balinese journeys. We specialize in intimate, high-end travel experiences
          that connect you with the true spirit of the island in absolute luxury.
        </p>
        <div class="flex gap-3">
          <a href="#" aria-label="Instagram" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 hover:bg-amber-500 hover:text-white hover:scale-110 transition-all duration-300">
            <span class="material-symbols-outlined text-lg">camera_alt</span>
          </a>
          <a href="mailto:hello@bbmtours.com" aria-label="Email" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 hover:bg-amber-500 hover:text-white hover:scale-110 transition-all duration-300">
            <span class="material-symbols-outlined text-lg">mail</span>
          </a>
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 hover:bg-amber-500 hover:text-white hover:scale-110 transition-all duration-300">
            <span class="material-symbols-outlined text-lg">chat</span>
          </a>
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="font-label text-amber-500 uppercase font-bold tracking-widest mb-5 text-sm">Explore</h4>
        <ul class="space-y-3 font-body text-stone-300 font-light text-sm">
          <li><a href="/tours" class="hover:text-white hover:translate-x-1 transition-all duration-200 block">Tour Packages</a></li>
          <li><a href="/tours/jeep-sunrise" class="hover:text-white hover:translate-x-1 transition-all duration-200 block">Jeep Sunrise Adventure</a></li>
          <li><a href="/about" class="hover:text-white hover:translate-x-1 transition-all duration-200 block">About Us</a></li>
          {exploreLinks.map((l) => (
            <li><a href={l.href} class="hover:text-white hover:translate-x-1 transition-all duration-200 block">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-label text-amber-500 uppercase font-bold tracking-widest mb-5 text-sm">Contact</h4>
        <ul class="space-y-3 font-body text-stone-300 font-light text-sm">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-400 text-lg mt-0.5 shrink-0">location_on</span>
            <span>Ubud, Bali, Indonesia</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-400 text-lg mt-0.5 shrink-0">phone</span>
            <a href="tel:+6281234567890" class="hover:text-white transition-colors">+62 812 3456 7890</a>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-400 text-lg mt-0.5 shrink-0">mail</span>
            <a href="mailto:hello@bbmtours.com" class="hover:text-white transition-colors">hello@bbmtours.com</a>
          </li>
        </ul>

        <a
          href="/contact"
          class="inline-block mt-6 bg-secondary-container text-on-secondary-container font-label text-xs uppercase tracking-widest font-bold px-6 py-3 rounded-xl hover:scale-[1.02] transition-transform"
        >
          Book Now
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="max-w-screen-2xl mx-auto px-6 md:px-8 mt-12 md:mt-16 flex flex-col md:flex-row justify-between items-center gap-3 text-stone-400 font-body text-xs md:text-sm font-light border-t border-white/5 pt-6">
    <p>&copy; 2026 BBM Tours &amp; Travel. Curated Eco-Experiences in the Heart of Bali.</p>
    <p class="flex items-center gap-1">
      Designed with
      <span class="material-symbols-outlined text-base text-amber-400" style="font-variation-settings:'FILL' 1">favorite</span>
      in Bali
    </p>
  </div>
</footer>
