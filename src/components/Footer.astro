---
const waBase = 'https://wa.me/6281238211110?text=Halo%20BBM%20Tours%2C%20saya%20ingin%20bertanya%20tentang%20paket%20wisata%20Anda.';
---

<footer class="bg-emerald-950 w-full pt-16 md:pt-24 pb-10 md:pb-12">
  <div class="max-w-screen-2xl mx-auto px-6 md:px-8 border-t border-white/10 pt-10 md:pt-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">

      <!-- Brand -->
      <div class="md:col-span-1">
        <h3 class="text-2xl md:text-3xl font-headline text-white mb-4 italic">BBM Tours &amp; Travel</h3>
        <p class="font-body text-stone-300 leading-relaxed max-w-md font-light mb-6 text-sm md:text-base">
          Curating conscious Balinese journeys. We specialize in intimate, high-end travel experiences
          that connect you with the true spirit of the island in absolute luxury.
        </p>
        <div class="flex gap-3">
          <a href="mailto:info@bbmtours.com" aria-label="Email" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 hover:bg-amber-500 hover:text-white hover:scale-110 transition-all duration-300">
            <span class="material-symbols-outlined text-lg">mail</span>
          </a>
          <a href={waBase} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-amber-400 hover:bg-amber-500 hover:text-white hover:scale-110 transition-all duration-300">
            <span class="material-symbols-outlined text-lg">chat</span>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-label text-amber-500 uppercase font-bold tracking-widest mb-5 text-sm">Quick Links</h4>
        <ul class="space-y-3 font-body text-stone-300 font-light text-sm">
          <li><a href="/" class="hover:text-white hover:translate-x-1 transition-all duration-200 block">Home</a></li>
          <li><a href="/tours" class="hover:text-white hover:translate-x-1 transition-all duration-200 block">Tour Packages</a></li>
          <li><a href="/about" class="hover:text-white hover:translate-x-1 transition-all duration-200 block">About Us</a></li>
          <li><a href="/contact" class="hover:text-white hover:translate-x-1 transition-all duration-200 block">Contact Us</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-label text-amber-500 uppercase font-bold tracking-widest mb-5 text-sm">Contact</h4>
        <ul class="space-y-3 font-body text-stone-300 font-light text-sm">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-400 text-lg mt-0.5 shrink-0">phone</span>
            <a href="tel:+6281238211110" class="hover:text-white transition-colors">+62 812-3821-1110</a>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-400 text-lg mt-0.5 shrink-0">mail</span>
            <a href="mailto:info@bbmtours.com" class="hover:text-white transition-colors">info@bbmtours.com</a>
          </li>
        </ul>

        <a
          href={waBase}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-6 bg-secondary-container text-on-secondary-container font-label text-xs uppercase tracking-widest font-bold px-6 py-3 rounded-xl hover:scale-[1.02] transition-transform"
        >
          <span class="material-symbols-outlined text-base">chat</span>
          Chat via WhatsApp
        </a>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="max-w-screen-2xl mx-auto px-6 md:px-8 mt-12 md:mt-16 flex flex-col md:flex-row justify-between items-center gap-3 text-stone-400 font-body text-xs md:text-sm font-light border-t border-white/5 pt-6">
    <p>&copy; 2026 BBM Tours &amp; Travel. Curated Eco-Experiences in the Heart of Bali.</p>
    <p class="flex items-center gap-1">
      Developed by
      <a href="https://wsrajasa.com" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-300 transition-colors ml-1">wsrajasa.com</a>
    </p>
  </div>
</footer>
