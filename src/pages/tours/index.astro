---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import TourCard from '../../components/tours/TourCard.astro';
import FilterSidebar from '../../components/tours/FilterSidebar.astro';

import tours from '../../data/tours.json';

const formattedTours = tours.map((tour, index) => ({
  ...tour,
  formattedPrice: `$${tour.price.toFixed(2)}`,
  aosDelay: (index % 3 * 100).toString(),
}));
---

<Layout
  title="Explore Our Curated Bali Journeys - BBM Tours & Travel"
  description="Elevate your journey with our handpicked, immersive Bali experiences."
>
  <Navbar activePage="destinations" />

  <main class="max-w-screen-2xl mx-auto px-4 md:px-8 py-12 md:py-24">
    <div data-aos="fade-up" class="mb-12 md:mb-24 max-w-3xl">
      <h1 class="text-3xl md:text-[3.5rem] leading-tight font-headline tracking-tight text-primary mb-4 md:mb-6">
        Unlock Extraordinary Bali Adventures
      </h1>
      <p class="text-base md:text-xl text-on-surface-variant font-body leading-relaxed">
        Elevate your journey with our handpicked, immersive experiences. Dive into the island's authentic soul,
        pristine nature, and vibrant culture for memories that last a lifetime.
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8 md:gap-12">
      <FilterSidebar />

      <div class="w-full lg:w-3/4">
        <div id="tours-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8 lg:gap-12">
          {formattedTours.map((tour) => (
            <div class="tour-item-wrapper" 
                 data-category={tour.category} 
                 data-duration={tour.duration.includes('Day') && !tour.duration.includes('/') ? '1 Day' : 'Multi-day'} 
                 data-price={tour.price}>
              <TourCard 
                image={tour.image}
                alt={tour.title}
                duration={tour.duration}
                title={tour.title}
                price={`$${tour.price.toFixed(2)}`}
                description={tour.short_description}
                href={`/tours/${tour.slug}`}
                aosDelay={tour.aosDelay}
              />
            </div>
          ))}
        </div>

        <!-- No Results -->
        <div id="no-results" class="hidden py-24 text-center">
          <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">search_off</span>
          <h3 class="font-headline text-2xl text-primary mb-2">No Journeys Found</h3>
          <p class="text-on-surface-variant font-body">Try adjusting your filters to find your perfect adventure.</p>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="mt-12 md:mt-16 flex justify-center items-center gap-3 md:gap-4">
          <button id="prev-page" class="w-11 h-11 md:w-12 md:h-12 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:border-primary hover:text-primary transition-colors disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Previous page">
            <span class="material-symbols-outlined">chevron_left</span>
          </button>
          <div id="page-numbers" class="flex items-center gap-2 font-label text-sm">
            <!-- Numbers generated by JS -->
          </div>
          <button id="next-page" class="w-11 h-11 md:w-12 md:h-12 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:border-primary hover:text-primary transition-colors disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Next page">
            <span class="material-symbols-outlined">chevron_right</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  let currentPage = 1;
  const itemsPerPage = 4;
  let filteredItems: HTMLElement[] = [];

  const toursGrid = document.getElementById('tours-grid');
  const tourItems = Array.from(document.querySelectorAll('.tour-item-wrapper')) as HTMLElement[];
  const noResults = document.getElementById('no-results');
  const pagination = document.getElementById('pagination');
  const pageNumbers = document.getElementById('page-numbers');
  const prevBtn = document.getElementById('prev-page') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-page') as HTMLButtonElement;

  function updateDisplay() {
    const categories = Array.from(document.querySelectorAll('.filter-checkbox[data-checked="true"]'))
      .map(cb => cb.parentElement?.querySelector('span')?.textContent?.trim());
    
    const duration = document.querySelector('.filter-radio[data-selected="true"]')?.parentElement?.querySelector('span')?.textContent?.trim();
    
    const maxPrice = parseInt((document.getElementById('price-range') as HTMLInputElement).value);

    filteredItems = tourItems.filter(item => {
      const itemCat = item.dataset.category;
      const itemDur = item.dataset.duration;
      const itemPrice = parseFloat(item.dataset.price || '0');

      const catMatch = categories.length === 0 || (itemCat && categories.includes(itemCat));
      const durMatch = !duration || duration === 'All' || itemDur === duration;
      const priceMatch = itemPrice <= maxPrice;

      return catMatch && durMatch && priceMatch;
    });

    const totalPages = Math.ceil(filteredItems.length / itemsPerPage);
    if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

    // Toggle visibility
    tourItems.forEach(item => item.classList.add('hidden'));
    
    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    const itemsToShow = filteredItems.slice(start, end);
    
    itemsToShow.forEach(item => item.classList.remove('hidden'));

    // Update UI
    if (noResults) noResults.classList.toggle('hidden', filteredItems.length > 0);
    if (pagination) pagination.classList.toggle('hidden', filteredItems.length === 0);
    
    updatePaginationUI(totalPages);
  }

  function updatePaginationUI(totalPages: number) {
    if (!pageNumbers || !prevBtn || !nextBtn) return;

    pageNumbers.innerHTML = '';
    for (let i = 1; i <= totalPages; i++) {
      const span = document.createElement('span');
      span.textContent = i.toString();
      span.className = `w-10 h-10 rounded-full flex items-center justify-center cursor-pointer transition-colors ${
        i === currentPage 
          ? 'bg-primary text-on-primary font-bold' 
          : 'hover:bg-surface-variant text-on-surface'
      }`;
      span.onclick = () => { currentPage = i; updateDisplay(); window.scrollTo({ top: 0, behavior: 'smooth' }); };
      pageNumbers.appendChild(span);
    }

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages || totalPages === 0;
  }

  prevBtn?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; updateDisplay(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });
  nextBtn?.addEventListener('click', () => { if (currentPage < Math.ceil(filteredItems.length / itemsPerPage)) { currentPage++; updateDisplay(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });

  // Listen for filter changes
  // We'll use a MutationObserver on the sidebar or just poll/add listeners to the sidebar elements
  // Since the sidebar script is already there, we can just add our updateDisplay to it or dispatch events.
  
  // Custom event approach
  document.addEventListener('filterChanged', () => {
    currentPage = 1;
    updateDisplay();
  });

  // Initial display
  updateDisplay();
</script>
