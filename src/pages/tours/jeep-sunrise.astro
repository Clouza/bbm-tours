---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import TourDetailHero from '../../components/tours/TourDetailHero.astro';
import TourItinerary from '../../components/tours/TourItinerary.astro';
import BookingWidget from '../../components/tours/BookingWidget.astro';

const itinerary = [
  { time: '04:00 AM', title: 'VIP Pick-up & Starlight Departure',  variant: 'default'   as const, description: 'Your personal expert guide arrives in your classic 4x4. We set off under a canopy of stars, beginning our ascent into the pristine eastern highlands.' },
  { time: '05:45 AM', title: 'The Ultimate Golden Hour',           variant: 'elevated'  as const, description: 'Reach our exclusive, private viewpoint. Indulge in an artisanal breakfast spread as you witness the majestic sunrise painting Mount Agung and the sweeping valleys in hues of gold.' },
  { time: '07:30 AM', title: 'Immersive Salak Agro Tour',          variant: 'default'   as const, description: "Venture into the heart of the Salak plantations. Engage with local custodians of the land, taste the exotic 'snake fruit' fresh from the palm, and immerse yourself in the traditions of organic Balinese farming." },
];

const inclusions = [
  { icon: 'directions_car', label: 'Private Classic 4x4 Transport' },
  { icon: 'person',         label: 'Expert Local Guide & Driver'   },
  { icon: 'restaurant',     label: 'Premium Artisan Breakfast'     },
  { icon: 'verified_user',  label: 'Comprehensive Premium Insurance' },
];

const gallery = [
  { src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDGnMSQY3MM5AbhyCmUWS6NTt8hhNgvmBAu73RI0GXpnqOb_f5hGPQGt_js0JQ6ix2KD6lX0wnQzY8wd72aFpU48yya66RkX8Tmr8SEUbBwts5Yfgq89GMTSRPUq-4PPaHP2rGss8p_OAzElYLmvVwTBQwXItVkGvVuIXdZ08kBSIgOjZmzu592J4RJHa8NrcwYpBhnyGSLN85J7viRHP2jzUYHTYjM78IdCKAUJxLzvMRSIxLobkm3Pr3qvAgJlhIlfIDgvZPVGIo', alt: 'Snake fruit Salak growing on a palm in a lush plantation', col: 'col-span-12',      h: 'h-80 md:h-96' },
  { src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuAIlQoO6WqKgZslt__sM2_UuY73L-pUKrHsjwbBHaBT-UN8-RnkctfyLnoTqtDua0jUV1Sx6InoR6ip3KvL0zbn26d78bRtyHq_yJFbZtnCyTyUtpnlBPpiZKpPSR67iRONdrw83gfuGM_xX1QScK32zce_9P_SAIHFf-dK6HQHwbh9rm8YrGEeLG9gCqRa-BZDf4WJPHBc7OnLeB_vEkztMrSviMv4nWbzNV09lBNmkd1ExbCvh19iyeYuSfJeCoeCTIqNc75PxX4', alt: 'Balinese farmer sorting tropical fruits in morning light',   col: 'col-span-12 md:col-span-7', h: 'h-64 md:h-80' },
  { src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDk9CfMhwWMBPIroFO391D4nj3O941Yw50A7C3VfTob6NcyWh-ZrEjo9uWFZgbQaxrGGNlWvS3nyPiCzxC4lcHOiZFIm6CshN8UNeeWG_APNI-fHky6914MmjWDcWAyD5fA6nFEUIjneLm5Ic596mTdokt-F1WwZXB8Sj-2Fo_WqWH30JjoEiYMeOhi0Nnbo2extnwAybMa-jRijrxJHqZg_PKHLDFL5iJaHZzB_TxO7Pk09XJJkrcldtuXm0Shi-icbCqXhkoa7AI', alt: 'Steaming Balinese coffee overlooking a jungle valley',        col: 'col-span-12 md:col-span-5', h: 'h-64 md:h-80' },
];
---

<Layout
  title="Salak Agro Jeep Sunrise Adventure - BBM Tours & Travel"
  description="Experience the magic of Bali's awakening. Journey through volcanic landscapes and lush plantations in a classic 4x4 for an unforgettable sunrise."
>
  <Navbar activePage="experiences" />

  <TourDetailHero
    image="https://lh3.googleusercontent.com/aida-public/AB6AXuCvmRwVE1fd6cfxF9DbKrks-nj8rBfKS2BCUeBJji9r8_AFMjvNbxwONcKzFWzAqHtOvOzKhsVIRjbgCWFGadPabZVeQoALisRhGwPHqOj4NU1E09ssFwkltIHKb3g7_uN3h2w39IScyYusFkPik9AIRy9wixivDzVj81Z_5IPA_noge9Dr5P922sK5GkNp6wTQb9xmlIhMLTKsE5Swffx1wygT12rItlsp0XBl777jQHKn3Xv6lC-cVQx80QKuYOnUtIGIj5xm8iY"
    alt="Classic 4x4 jeep on a volcanic mountain ridge during Bali sunrise"
    badge="Epic Half Day Tour"
    title="Salak Agro Jeep Sunrise Adventure"
    description="Experience the magic of Bali's awakening. Journey through volcanic landscapes and lush plantations in a classic 4x4 for an unforgettable sunrise."
  />

  <main class="w-full max-w-screen-2xl mx-auto px-4 md:px-8 py-12 md:py-16 grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-16">
    <!-- Left: Editorial Content -->
    <div class="lg:col-span-8 flex flex-col gap-16 md:gap-24">

      <!-- Overview -->
      <section data-aos="fade-up" class="flex flex-col gap-5 md:gap-6">
        <h2 class="font-headline text-3xl md:text-4xl text-primary font-semibold tracking-tight">An Unparalleled Awakening</h2>
        <div class="font-body text-base md:text-lg text-on-surface-variant leading-relaxed space-y-5 md:space-y-6">
          <p>Leave the crowds behind and embrace the dawn in the rugged beauty of Bali's eastern highlands. Our exclusive Salak Agro Jeep Sunrise Adventure offers a raw, authentic connection with the island's spectacular volcanic terrain. Aboard our meticulously maintained classic 4x4 jeeps, you'll embark on a thrilling ascent to a private vantage point, perfectly timed to witness a sunrise that sets the sky ablaze.</p>
          <p>The magic continues as we descend into verdant, emerald canopies of native Salak (Snake Fruit) plantations. This is more than a tour; it's an immersive cultural exchange. Walk alongside passionate local farmers, discover the secrets of sustainable organic agriculture, and savor the rich, complex flavors of freshly brewed Balinese coffee amidst the vibrant symphony of the jungle.</p>
        </div>
      </section>

      <!-- Gallery -->
      <section data-aos="fade-up" class="flex flex-col gap-4 md:gap-6">
        <h2 class="font-headline text-2xl md:text-3xl text-primary font-semibold tracking-tight">Glimpses of Your Journey</h2>
        <div class="grid grid-cols-12 gap-3 md:gap-4">
          {gallery.map((img, i) => (
            <div data-aos="fade-up" data-aos-delay={String(i * 80)} class={`${img.col} ${img.h} rounded-lg overflow-hidden relative group`}>
              <img alt={img.alt} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src={img.src} />
            </div>
          ))}
        </div>
      </section>

      <TourItinerary items={itinerary} />

      <!-- Mobile Booking CTA (visible only on small screens, above the fold on scroll) -->
      <div class="lg:hidden">
        <a
          href="#booking-widget"
          class="block w-full text-center bg-secondary-container text-on-secondary-container py-4 rounded-xl font-label text-sm uppercase tracking-widest font-bold hover:scale-[1.02] transition-transform shadow-lg"
        >
          Book This Experience
        </a>
      </div>

    </div>

    <!-- Right: Sticky Booking Widget -->
    <div class="lg:col-span-4">
      <BookingWidget
        priceFrom="$120"
        basePrice={120}
        inclusions={inclusions}
        whatsappNumber="6281234567890"
      />
    </div>
  </main>

  <Footer />
</Layout>
