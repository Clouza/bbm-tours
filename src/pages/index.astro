---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/home/HeroSection.astro';
import FeaturedTours from '../components/home/FeaturedTours.astro';
import WhyBBM from '../components/home/WhyBBM.astro';
import Testimonials from '../components/home/Testimonials.astro';
import CTABanner from '../components/home/CTABanner.astro';
---

<Layout title="BBM Tours & Travel - Premium Bali Experiences">
  <Navbar activePage="home" />
  <main class="pb-32">
    <HeroSection />
    <FeaturedTours />
    <WhyBBM />
    <Testimonials />
    <CTABanner />
  </main>
  <Footer />
</Layout>
